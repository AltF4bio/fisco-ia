# =============================================================================
# FISCO.IA — variáveis de ambiente
# Copie para ".env" e ajuste. O arquivo .env NUNCA deve ser versionado.
# =============================================================================

# --- Django -------------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Necessário apenas se acessar por outro host/porta (ex.: http://localhost:8000)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Execução local (venv) com o banco do docker compose exposto na porta 5432:
DATABASE_URL=postgres://fisco:fisco@localhost:5432/fisco
# Dentro do docker compose o serviço "web" usa o host "db" (definido no compose).

# --- Criptografia das chaves de API ------------------------------------------
# Chave mestra Fernet usada para cifrar as chaves dos provedores no banco.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: se esta chave for perdida, as chaves de API cadastradas precisam ser
# informadas novamente.
FISCO_ENCRYPTION_KEY=

# --- Comportamento do sistema -------------------------------------------------
# Modo demonstração: ativa o MockProvider (respostas determinísticas de exemplo),
# permitindo usar o sistema sem chaves reais de OpenAI/Anthropic/Google.
FISCO_MODO_DEMO=True
# Índice mínimo de qualidade da extração (0 a 1). Abaixo dele, o sistema alerta
# que o PDF pode estar digitalizado sem OCR, manuscrito ou corrompido.
FISCO_LIMIAR_QUALIDADE=0.6
# Tamanho máximo do PDF enviado, em MB.
FISCO_PDF_MAX_MB=30
# Diretórios temporários (opcionais). Padrão: pasta temporária do sistema.
# FISCO_TEMP_DIR=/tmp/fisco-ia-autos
# FISCO_SESSION_CACHE_DIR=/tmp/fisco-ia-sessoes
# Duração da sessão (o resultado das análises existe só durante a sessão).
FISCO_SESSAO_MINUTOS=120
# Tempo máximo de espera por resposta de um provedor de IA, em segundos.
FISCO_LLM_TIMEOUT=180
